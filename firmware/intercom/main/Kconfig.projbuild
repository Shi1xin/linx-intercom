menu "Intercom Configuration"

    config INTERCOM_WIFI_SSID
        string "Wi-Fi SSID"
        default "YOUR_SSID"
        help
            Wi-Fi STA ssid. Override at build time for the target network.

    config INTERCOM_WIFI_PASSWORD
        string "Wi-Fi Password"
        default "YOUR_PASSWORD"
        help
            Wi-Fi STA password.

    config INTERCOM_CTRL_URL
        string "Control WebSocket URL"
        default "ws://10.234.79.213:8090/ws"
        help
            Control service endpoint, e.g. ws://<host>:8090/ws

    config INTERCOM_DEVICE_TOKEN
        string "Device token sent in hello"
        default "dev"

    config INTERCOM_TURN_URL
        string "TURN/STUN server URL (empty = host candidates only)"
        default "turn:10.234.79.213:3478?transport=udp"
        help
            ICE server URL passed to esp_peer, e.g. turn:host:3478?transport=udp
            or stun:host:3478. Leave empty to use host candidates only.

    config INTERCOM_TURN_USER
        string "TURN username"
        default "intercom"

    config INTERCOM_TURN_PASS
        string "TURN password"
        default "night2026"

    config INTERCOM_CMD_TARGET_KIND
        string "Command recognition stub join target kind"
        default "room_name"
        help
            Placeholder command recognizer emits a join with this target kind:
            nfc | device | invite | room_name

    config INTERCOM_CMD_TARGET_ARG
        string "Command recognition stub join target argument"
        default "一号房"
        help
            Argument for the stub join target (room name / invite code / entry id).

    config INTERCOM_LINX_ENABLE
        bool "Connect to the Linx platform (default conversation channel)"
        default y

    config INTERCOM_LINX_OTA_URL
        string "Linx OTA gateway URL"
        default "https://xrobo.qiniuapi.com/v1/ota/"

    config INTERCOM_LINX_DEVICE_ID
        string "Platform Device-Id override (empty = Wi-Fi MAC)"
        default ""
        help
            Device identity presented to OTA/WebSocket headers. Leave empty to
            use the Wi-Fi STA MAC.

    config INTERCOM_LINX_CLIENT_ID
        string "Platform Client-Id override (empty = generated uuid in NVS)"
        default ""

    config INTERCOM_LINX_BOARD_TYPE
        string "Board type reported to OTA"
        default "bread-compact-wifi"

    config INTERCOM_LINX_SELFTEST_TEXT
        string "listen.detect text sent once after MCP tools/list (empty = off)"
        default ""
        help
            Headless test hook: simulates a spoken command. Emitted once per
            session ~1 s after the platform finishes tools/list.

    config INTERCOM_SPEAKER_ENABLE
        bool "Enable speaker playback (set n for silent bench tests)"
        default y

endmenu
